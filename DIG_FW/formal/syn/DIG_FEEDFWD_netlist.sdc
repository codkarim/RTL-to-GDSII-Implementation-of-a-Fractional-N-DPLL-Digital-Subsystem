set_load -pin_load 0.5 [get_ports {DAC_IN[1]}]
set_load -pin_load 0.5 [get_ports {DAC_IN[0]}]
set_load -pin_load 0.5 [get_ports OV_FL]
set_load -pin_load 0.5 [get_ports UN_FL]
create_clock [get_ports REF_CLK]  -name MASTER_CLK  -period 20  -waveform {0 10}
set_clock_uncertainty -setup 0.25  [get_clocks MASTER_CLK]
set_clock_uncertainty -hold 0.05  [get_clocks MASTER_CLK]
set_clock_transition -max -rise 0.1 [get_clocks MASTER_CLK]
set_clock_transition -min -rise 0.1 [get_clocks MASTER_CLK]
set_clock_transition -max -fall 0.1 [get_clocks MASTER_CLK]
set_clock_transition -min -fall 0.1 [get_clocks MASTER_CLK]
group_path -name INOUT  -from [list [get_ports REF_CLK] [get_ports RST] [get_ports DLF_Ext_En] [get_ports {DLF_Ext_Data[14]}] [get_ports {DLF_Ext_Data[13]}] [get_ports {DLF_Ext_Data[12]}] [get_ports {DLF_Ext_Data[11]}] [get_ports {DLF_Ext_Data[10]}] [get_ports {DLF_Ext_Data[9]}] [get_ports {DLF_Ext_Data[8]}] [get_ports {DLF_Ext_Data[7]}] [get_ports {DLF_Ext_Data[6]}] [get_ports {DLF_Ext_Data[5]}] [get_ports {DLF_Ext_Data[4]}] [get_ports {DLF_Ext_Data[3]}] [get_ports {DLF_Ext_Data[2]}] [get_ports {DLF_Ext_Data[1]}] [get_ports {DLF_Ext_Data[0]}] [get_ports {TDC_OUT[3]}] [get_ports {TDC_OUT[2]}] [get_ports {TDC_OUT[1]}] [get_ports {TDC_OUT[0]}] [get_ports {KP[3]}] [get_ports {KP[2]}] [get_ports {KP[1]}] [get_ports {KP[0]}] [get_ports {KI[3]}] [get_ports {KI[2]}] [get_ports {KI[1]}] [get_ports {KI[0]}]]  -to [list [get_ports {DAC_IN[4]}] [get_ports {DAC_IN[3]}] [get_ports {DAC_IN[2]}] [get_ports {DAC_IN[1]}] [get_ports {DAC_IN[0]}] [get_ports OV_FL] [get_ports UN_FL]]
group_path -name INREG  -from [list [get_ports REF_CLK] [get_ports RST] [get_ports DLF_Ext_En] [get_ports {DLF_Ext_Data[14]}] [get_ports {DLF_Ext_Data[13]}] [get_ports {DLF_Ext_Data[12]}] [get_ports {DLF_Ext_Data[11]}] [get_ports {DLF_Ext_Data[10]}] [get_ports {DLF_Ext_Data[9]}] [get_ports {DLF_Ext_Data[8]}] [get_ports {DLF_Ext_Data[7]}] [get_ports {DLF_Ext_Data[6]}] [get_ports {DLF_Ext_Data[5]}] [get_ports {DLF_Ext_Data[4]}] [get_ports {DLF_Ext_Data[3]}] [get_ports {DLF_Ext_Data[2]}] [get_ports {DLF_Ext_Data[1]}] [get_ports {DLF_Ext_Data[0]}] [get_ports {TDC_OUT[3]}] [get_ports {TDC_OUT[2]}] [get_ports {TDC_OUT[1]}] [get_ports {TDC_OUT[0]}] [get_ports {KP[3]}] [get_ports {KP[2]}] [get_ports {KP[1]}] [get_ports {KP[0]}] [get_ports {KI[3]}] [get_ports {KI[2]}] [get_ports {KI[1]}] [get_ports {KI[0]}]]
